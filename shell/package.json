{
  "name": "jhon-shell",
  "version": "0.2.0",
  "private": true,
  "description": "Jhon's pi shell: the pi package that runs the Jhon framework in pi",
  "type": "module",
  "license": "Apache-2.0",
  "jhon": {
    "contract": "jhon.shell/v1"
  },
  "pi": {
    "extensions": [
      "./extensions/jhon.ts",
      "./extensions/ui.ts",
      "./extensions/pretty.ts",
      "./extensions/todo.ts",
      "./extensions/quiet.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-timeout=120000 test/*.test.ts",
    "check": "tsc -p ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "typescript": "7.0.2"
  }
}
